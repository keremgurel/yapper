{
  "description": "Clip and track edits on the timeline: split, delete, trim, move, lock, speed.",
  "runtime": "client",
  "actions": [
    {
      "id": "editor.clips.setSpeed",
      "symbol": "clipSpeed",
      "input": "ClipSpeedInput",
      "description": "Set playback speed for explicit clip IDs, preserving voice pitch. Locked clips are skipped.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.timeline.setLocked",
      "symbol": "timelineLock",
      "input": "TimelineLockInput",
      "description": "Lock or unlock explicit clips and captions to protect their edits.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.timeline.split",
      "symbol": "timelineSplit",
      "input": "TimelineSplitInput",
      "description": "Split explicit timeline items (clips, captions, text layers, overlays, sounds) at one timeline anchor. Items the anchor does not fall inside are left alone. Locked clips and captions are skipped. The receipt names each new tail ID.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.timeline.delete",
      "symbol": "timelineDelete",
      "input": "TimelineDeleteInput",
      "description": "Remove explicit timeline items by ID: clips, captions, text layers, overlays, or sounds. Removing a clip closes the gap. Locked clips and captions are skipped.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.timeline.trim",
      "symbol": "timelineTrim",
      "input": "TimelineTrimInput",
      "description": "Move the leading or trailing edge of explicit timeline items to one timeline anchor. leading keeps everything after the anchor; trailing keeps everything before it. The anchor must fall inside each item. Locked items are skipped.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.clips.reorder",
      "symbol": "clipReorder",
      "input": "ClipReorderInput",
      "description": "Move explicit main-track clips as one block so it starts at insertionIndex among the remaining clips (0 is first). Cannot reorder across a locked clip.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.timeline.shift",
      "symbol": "timelineShift",
      "input": "TimelineShiftInput",
      "description": "Slide explicit captions, text layers, overlays, or sounds along the timeline by deltaSeconds (negative is earlier), clamped to the project. Clips are in a running order; use editor.clips.reorder for them.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.timeline.transfer",
      "symbol": "trackTransfer",
      "input": "TrackTransferInput",
      "description": "Move a clip to an overlay lane or an overlay onto the main track. toOverlay requires itemID of an unlocked clip and optional at/track; at is a timeline anchor. toMainTrack requires overlay itemID and insertionIndex (0-based). Keeps source trim and speed. At least one main-track clip must remain.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.timeline.clearTrack",
      "symbol": "clearTrack",
      "input": "ClearTrackInput",
      "description": "Clear all main-track clips, or all captions and caption visibility, as the manual clear-track control. Original media stays in the bin. Locked content is protected.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    }
  ],
  "$defs": {
    "ClipSpeedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clipIDs", "rate"],
      "properties": {
        "clipIDs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "rate": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4
        }
      }
    },
    "TimelineLockInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clipIDs", "captionIDs", "locked"],
      "properties": {
        "clipIDs": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "captionIDs": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "locked": {
          "type": "boolean"
        }
      }
    },
    "TimelineEdge": {
      "type": "string",
      "enum": ["leading", "trailing"]
    },
    "TimelineSplitInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemIDs", "at"],
      "properties": {
        "itemIDs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "at": {
          "$ref": "#/$defs/TimelineAnchorInput"
        }
      }
    },
    "TimelineDeleteInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemIDs"],
      "properties": {
        "itemIDs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "TimelineTrimInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemIDs", "edge", "to"],
      "properties": {
        "itemIDs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "edge": {
          "$ref": "#/$defs/TimelineEdge"
        },
        "to": {
          "$ref": "#/$defs/TimelineAnchorInput"
        }
      }
    },
    "ClipReorderInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clipIDs", "insertionIndex"],
      "properties": {
        "clipIDs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "insertionIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        }
      }
    },
    "TimelineShiftInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemIDs", "deltaSeconds"],
      "properties": {
        "itemIDs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "deltaSeconds": {
          "type": "number",
          "minimum": -86400,
          "maximum": 86400
        }
      }
    },
    "TrackTransferDirection": {
      "type": "string",
      "enum": ["toOverlay", "toMainTrack"]
    },
    "TrackTransferInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemID", "direction"],
      "properties": {
        "itemID": {
          "type": "string",
          "format": "uuid"
        },
        "direction": {
          "$ref": "#/$defs/TrackTransferDirection"
        },
        "at": {
          "$ref": "#/$defs/TimelineAnchorInput"
        },
        "track": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "insertionIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        }
      }
    },
    "ClearTrackKind": {
      "type": "string",
      "enum": ["video", "captions"]
    },
    "ClearTrackInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track"],
      "properties": {
        "track": {
          "$ref": "#/$defs/ClearTrackKind"
        }
      }
    }
  }
}
