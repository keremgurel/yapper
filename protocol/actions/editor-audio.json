{
  "description": "Sound placement, volume, replacement and trimming of audio layers.",
  "runtime": "client",
  "actions": [
    {
      "id": "editor.clips.extractAudio",
      "symbol": "extractAudio",
      "input": "ExtractAudioInput",
      "description": "Extract audio from explicit video clip or overlay IDs into independent audio layers, preserving trim and speed and silencing the original clips. Locked, silent and already extracted clips are skipped.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.sounds.addAtReveals",
      "symbol": "revealSounds",
      "input": "RevealSoundsInput",
      "description": "Add a library sound at explicit saved reveal events, using the animation times already in the scene. Does not add or move overlays. Repeating the same sound at the same reveal is a no-op.",
      "effect": "reversibleEdit",
      "requiresRebuild": true,
      "legacy": true
    },
    {
      "id": "editor.audio.addAt",
      "symbol": "soundAt",
      "input": "SoundAtInput",
      "description": "Place an installed library sound at one or more timing anchors: explicit timeline times, playhead, speechStart, exact phrase/occurrence, or a saved animation event ID. Uses the same timing resolver as keyframes. Repeating the same effect at the same time is a no-op. Changes audio only.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.audio.setVolume",
      "symbol": "audioVolume",
      "input": "AudioVolumeInput",
      "description": "Set playback volume (0 silent, 1 unity, up to 2) on explicit audio layer IDs and, when videoTrack is true, on the speaker's own video track. Raising the video track above 0 also unmutes it.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.audio.replace",
      "symbol": "audioReplace",
      "input": "AudioReplaceInput",
      "description": "Replace existing sound layers with a built-in sound from soundLibrary, keeping timeline placement and volume. Resets source trim and rate to the new sound.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.audio.trim",
      "symbol": "audioTrim",
      "input": "AudioTrimInput",
      "description": "Set source in point and/or duration of existing audio layers. Preserve timeline position, volume and speed. SourceStart is recording seconds; duration is timeline seconds.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.audio.addSaved",
      "symbol": "savedAudioAdd",
      "input": "SavedAudioAddInput",
      "description": "Place existing audio from savedAudioLibrary at a timeline anchor. Keeps the library default volume and adds the actual saved source; no paths are accepted.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    }
  ],
  "$defs": {
    "ExtractAudioInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clipIDs", "overlayIDs"],
      "properties": {
        "clipIDs": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "overlayIDs": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "RevealSoundsInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectID", "eventIDs"],
      "properties": {
        "effectID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "eventIDs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        }
      }
    },
    "SoundAtInput": {
      "type": "object",
      "properties": {
        "effectID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "at": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/TimelineAnchorInput"
          }
        }
      },
      "required": ["effectID", "at"],
      "additionalProperties": false
    },
    "AudioVolumeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layerIDs", "videoTrack", "volume"],
      "properties": {
        "layerIDs": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "videoTrack": {
          "type": "boolean"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "AudioReplaceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layerIDs", "effectID"],
      "properties": {
        "layerIDs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true
        },
        "effectID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "AudioTrimInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layerIDs"],
      "properties": {
        "layerIDs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true
        },
        "sourceStart": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "duration": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 86400
        }
      }
    },
    "SavedAudioAddInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["savedAudioID", "at"],
      "properties": {
        "savedAudioID": {
          "type": "string",
          "format": "uuid"
        },
        "at": {
          "$ref": "#/$defs/TimelineAnchorInput"
        }
      }
    }
  }
}
