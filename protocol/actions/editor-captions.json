{
  "description": "Captions and free text layers, which share one text style.",
  "runtime": "client",
  "actions": [
    {
      "id": "editor.captions.setVisible",
      "symbol": "captionVisibility",
      "input": "CaptionVisibilityInput",
      "description": "Show or hide existing captions, preserving their text and styling. If showing captions for the first time, generate them from speech using the caption workflow. regenerate=true (with visible=true) rebuilds every card from the current transcript and cut, transcribing first if needed, and discards hand edits to caption text.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.captions.setStyle",
      "symbol": "captionStyle",
      "input": "CaptionStyleInput",
      "description": "Set caption style fields on explicit caption IDs, or on the shared caption style when applyToAll is true. Send only the fields to change; unmentioned fields keep their values. Locked captions are skipped. Position, width and fontScale are fractions of the frame; strokeWidth is a fraction of the font size.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.text.setStyle",
      "symbol": "textLayerStyle",
      "input": "TextLayerStyleInput",
      "description": "Set style fields on explicit text layer IDs. Same fields and units as caption style; send only the fields to change.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.captions.add",
      "symbol": "captionAdd",
      "input": "CaptionAddInput",
      "description": "Add a caption card. Either at a timeline anchor over spoken footage, or right after an existing caption (afterCaptionID). Optional text sets what the card says; otherwise it takes the spoken words there.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.captions.remove",
      "symbol": "captionRemove",
      "input": "CaptionRemoveInput",
      "description": "Remove explicit caption cards by ID. Locked captions are skipped. To hide all captions without deleting them use editor.captions.setVisible.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.captions.merge",
      "symbol": "captionMerge",
      "input": "CaptionMergeInput",
      "description": "Merge two or more caption cards into one card spanning them, keeping their words in order.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.captions.setText",
      "symbol": "captionText",
      "input": "CaptionTextInput",
      "description": "Replace the text of one caption card. The card stops following the transcript for that text.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.captions.retime",
      "symbol": "captionRetime",
      "input": "CaptionRetimeInput",
      "description": "Move a caption card to a new timeline start and end in seconds. A card can only sit over the footage it was spoken over.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.text.add",
      "symbol": "textLayerAdd",
      "input": "TextLayerAddInput",
      "description": "Add an on-screen text layer with the given text at a timeline anchor (default the playhead) for duration seconds (default 5). asHook places it at the very start with the hook look.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.text.update",
      "symbol": "textLayerUpdate",
      "input": "TextLayerUpdateInput",
      "description": "Change a text layer's words, timeline start, or duration. Send only the fields to change. Remove a layer with editor.timeline.delete.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.captions.splitAtWord",
      "symbol": "captionSplit",
      "input": "CaptionSplitInput",
      "description": "Split one caption after a word count, as pressing Enter at a word boundary. Locked captions are skipped.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    }
  ],
  "$defs": {
    "CaptionVisibilityInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible"],
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "regenerate": {
          "type": "boolean"
        }
      }
    },
    "TextFontChoice": {
      "type": "string",
      "enum": ["modern", "rounded", "editorial"]
    },
    "TextCaseChoice": {
      "type": "string",
      "enum": ["asSpoken", "lower", "upper"]
    },
    "TextStyleInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.95,
          "description": "Horizontal centre as a fraction of frame width."
        },
        "y": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.95,
          "description": "Vertical centre as a fraction of frame height; 0 is the top."
        },
        "width": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 1
        },
        "rotation": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "font": {
          "$ref": "#/$defs/TextFontChoice"
        },
        "fontScale": {
          "type": "number",
          "minimum": 0.012,
          "maximum": 0.22,
          "description": "Cap height as a fraction of frame height. Captions default near 0.05."
        },
        "textCase": {
          "$ref": "#/$defs/TextCaseChoice"
        },
        "color": {
          "type": "string",
          "minLength": 4,
          "maxLength": 9,
          "description": "Hex colour: #RGB, #RRGGBB or #RRGGBBAA."
        },
        "strokeEnabled": {
          "type": "boolean"
        },
        "strokeColor": {
          "type": "string",
          "minLength": 4,
          "maxLength": 9,
          "description": "Hex colour: #RGB, #RRGGBB or #RRGGBBAA."
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.24
        },
        "backgroundEnabled": {
          "type": "boolean"
        },
        "backgroundColor": {
          "type": "string",
          "minLength": 4,
          "maxLength": 9,
          "description": "Hex colour: #RGB, #RRGGBB or #RRGGBBAA."
        },
        "cornerRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "shadowEnabled": {
          "type": "boolean"
        },
        "shadowColor": {
          "type": "string",
          "minLength": 4,
          "maxLength": 9,
          "description": "Hex colour: #RGB, #RRGGBB or #RRGGBBAA."
        },
        "shadowRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "CaptionStyleInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captionIDs", "applyToAll", "style"],
      "properties": {
        "captionIDs": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "applyToAll": {
          "type": "boolean"
        },
        "style": {
          "$ref": "#/$defs/TextStyleInput"
        }
      }
    },
    "TextLayerStyleInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textLayerIDs", "style"],
      "properties": {
        "textLayerIDs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "style": {
          "$ref": "#/$defs/TextStyleInput"
        }
      }
    },
    "CaptionAddInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "at": {
          "$ref": "#/$defs/TimelineAnchorInput"
        },
        "afterCaptionID": {
          "type": "string",
          "format": "uuid"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "CaptionRemoveInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captionIDs"],
      "properties": {
        "captionIDs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "CaptionMergeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captionIDs"],
      "properties": {
        "captionIDs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "CaptionTextInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captionID", "text"],
      "properties": {
        "captionID": {
          "type": "string",
          "format": "uuid"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "CaptionRetimeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captionID", "timelineStart", "timelineEnd"],
      "properties": {
        "captionID": {
          "type": "string",
          "format": "uuid"
        },
        "timelineStart": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "timelineEnd": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        }
      }
    },
    "TextLayerAddInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "at": {
          "$ref": "#/$defs/TimelineAnchorInput"
        },
        "duration": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 600
        },
        "asHook": {
          "type": "boolean"
        }
      }
    },
    "TextLayerUpdateInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textLayerID"],
      "properties": {
        "textLayerID": {
          "type": "string",
          "format": "uuid"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "timelineStart": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "duration": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 600
        }
      }
    },
    "CaptionSplitInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captionID", "afterWords"],
      "properties": {
        "captionID": {
          "type": "string",
          "format": "uuid"
        },
        "afterWords": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      }
    }
  }
}
