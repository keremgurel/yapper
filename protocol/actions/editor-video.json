{
  "description": "Static and animated framing, retouch and background of video clips.",
  "runtime": "client",
  "actions": [
    {
      "id": "editor.video.animateFraming",
      "symbol": "framingAnimation",
      "input": "FramingAnimationInput",
      "description": "Animate main-video scale, position, and rotation with ordered keyframes. Each key has a timeline timing anchor and a scale multiplier relative to the existing framing; optional x/y are frame-fraction offsets and rotation is a degree offset. easing controls the segment leading to the next key. pivot face keeps the detected face in place while scaling; frameCenter uses the current framing center. Existing keys outside the key interval and all other tracks are preserved. Keys may span video cuts. Use real times or local phrase/speechStart anchors; ambiguous or missing cues are rejected. Include a final multiplier 1 with zero offsets when returning to the existing framing. There is no implicit entry key: to begin smoothly from the existing framing, explicitly include an initial scaleMultiplier 1 with zero offsets at the beginning of the move, followed by the changed framing at its arrival time.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.video.setFraming",
      "symbol": "videoFraming",
      "input": "VideoFramingInput",
      "description": "Set the static framing of explicit main-video clip IDs: scale multiplier, x/y offset as frame fractions, rotation in degrees. Send only the fields to change. Clips with framing keyframes are rejected; use editor.video.animateFraming for those. Locked clips are skipped.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.retouch.set",
      "symbol": "clipRetouch",
      "input": "ClipRetouchInput",
      "description": "Set face retouch strengths (0 to 1) on explicit clip IDs: clearBlemishes and whitenTeeth. Send only the fields to change. Locked clips are skipped.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.background.set",
      "symbol": "clipBackground",
      "input": "ClipBackgroundInput",
      "description": "Keep or remove the room behind the speaker on explicit clip IDs. When removed, the project backdrop colour shows behind the speaker. Locked clips are skipped.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.video.framingKey",
      "symbol": "videoFramingKey",
      "input": "VideoFramingKeyInput",
      "description": "Set, remove, move or clear absolute video framing keys on a clip, like the manual diamonds. sourceTime/destination are recording seconds inside that clip, not timeline time. set without framing fields captures the current framing. clear leaves framing sampled at sourceTime. Locked clips are skipped.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    }
  ],
  "$defs": {
    "AnimationPivot": {
      "type": "string",
      "enum": ["frameCenter", "face"]
    },
    "FramingAnimationKey": {
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/TimelineAnchorInput"
        },
        "scaleMultiplier": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 5
        },
        "x": {
          "type": "number",
          "minimum": -1.5,
          "maximum": 1.5
        },
        "y": {
          "type": "number",
          "minimum": -1.5,
          "maximum": 1.5
        },
        "rotation": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "easing": {
          "$ref": "#/$defs/AnimationEase"
        }
      },
      "required": ["at", "scaleMultiplier"],
      "additionalProperties": false
    },
    "FramingAnimationInput": {
      "type": "object",
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/FramingAnimationKey"
          }
        },
        "pivot": {
          "$ref": "#/$defs/AnimationPivot"
        }
      },
      "required": ["keys"],
      "additionalProperties": false
    },
    "VideoFramingInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clipIDs"],
      "properties": {
        "clipIDs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "scale": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 5
        },
        "x": {
          "type": "number",
          "minimum": -1.5,
          "maximum": 1.5
        },
        "y": {
          "type": "number",
          "minimum": -1.5,
          "maximum": 1.5
        },
        "rotation": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "ClipRetouchInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clipIDs"],
      "properties": {
        "clipIDs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "clearBlemishes": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "whitenTeeth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "ClipBackgroundInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clipIDs", "removed"],
      "properties": {
        "clipIDs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "removed": {
          "type": "boolean"
        }
      }
    },
    "VideoFramingKeyInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clipID", "sourceTime", "operation"],
      "properties": {
        "clipID": {
          "type": "string",
          "format": "uuid"
        },
        "sourceTime": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "operation": {
          "$ref": "#/$defs/OverlayKeyOperation"
        },
        "destination": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "scale": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 5
        },
        "x": {
          "type": "number",
          "minimum": -1.5,
          "maximum": 1.5
        },
        "y": {
          "type": "number",
          "minimum": -1.5,
          "maximum": 1.5
        },
        "rotation": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    }
  }
}
