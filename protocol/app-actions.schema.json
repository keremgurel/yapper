{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ypr.app/schemas/app-actions/v1",
  "title": "Yapper shared app actions",
  "x-protocolVersion": 1,
  "x-actions": [
    {
      "id": "editor.clips.extractAudio",
      "symbol": "extractAudio",
      "input": "ExtractAudioInput",
      "description": "Extract audio from explicit video clip or overlay IDs into independent audio layers, preserving trim and speed and silencing the original clips. Locked, silent and already extracted clips are skipped.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.clips.setSpeed",
      "symbol": "clipSpeed",
      "input": "ClipSpeedInput",
      "description": "Set playback speed for explicit clip IDs, preserving voice pitch. Locked clips are skipped.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.timeline.setLocked",
      "symbol": "timelineLock",
      "input": "TimelineLockInput",
      "description": "Lock or unlock explicit clips and captions to protect their edits.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.captions.setVisible",
      "symbol": "captionVisibility",
      "input": "CaptionVisibilityInput",
      "description": "Show or hide existing captions, preserving their text and styling. If showing captions for the first time, generate them from speech using the caption workflow.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.reveals.setPolicy",
      "symbol": "revealPolicy",
      "input": "RevealPolicyInput",
      "description": "Set visibility policies for explicit regions of an image overlay. alwaysVisible removes only those masks; untilCue uses the saved spoken cue; alwaysHidden requires an explicit request to keep a value hidden.",
      "effect": "reversibleEdit",
      "requiresRebuild": true,
      "legacy": true
    },
    {
      "id": "editor.sounds.addAtReveals",
      "symbol": "revealSounds",
      "input": "RevealSoundsInput",
      "description": "Add a library sound at explicit saved reveal events, using the animation times already in the scene. Does not add or move overlays. Repeating the same sound at the same reveal is a no-op.",
      "effect": "reversibleEdit",
      "requiresRebuild": true,
      "legacy": true
    },
    {
      "id": "editor.transcribe",
      "symbol": "transcribeWorkflow",
      "input": "TranscribeWorkflowInput",
      "description": "Transcribe the project speech using the app transcription workflow.",
      "effect": "workflow",
      "requiresRebuild": true
    },
    {
      "id": "editor.cleanup",
      "symbol": "cleanupWorkflow",
      "input": "CleanupWorkflowInput",
      "description": "Run the app one-click AI cleanup workflow on the project.",
      "effect": "workflow",
      "requiresRebuild": true
    },
    {
      "id": "editor.trimSilences",
      "symbol": "silenceWorkflow",
      "input": "SilenceWorkflowInput",
      "description": "Trim silences using the app silence trimming workflow. With clipIDs, only silences inside those main-track clips are cut; without, the whole timeline is trimmed.",
      "effect": "workflow",
      "requiresRebuild": true
    },
    {
      "id": "editor.designOverlays",
      "symbol": "overlayWorkflow",
      "input": "OverlayWorkflowInput",
      "description": "Create or revise visual overlays using the app visual design workflow. Use only when the user requests visual creation or redesign. Never use this to add sounds or to edit existing masks.",
      "effect": "workflow",
      "requiresRebuild": true
    },
    {
      "id": "editor.overlays.zoom",
      "symbol": "overlayZoom",
      "input": "OverlayZoomInput",
      "description": "Animate a zoom into a specific source region of an existing overlay, preserving its placement and masks. target is normalized source coordinates with a top-left origin. Times are seconds from the overlay start. Smooth zoom holds after endTime; optional returnStart and returnEnd zoom back. Use known region boxes or the supplied selected-overlay image to locate the requested section; ask if the target region is ambiguous.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.overlays.keyframe",
      "symbol": "overlayKeyframe",
      "input": "OverlayKeyframeInput",
      "description": "Set, remove, move or clear a keyframe on an overlay. time and destination are seconds from the overlay start. A set with no box or crop captures the current frame. box uses fractions of the video frame; crop uses normalized source coordinates. clear freezes the frame at time.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.overlays.setCrop",
      "symbol": "overlayCrop",
      "input": "OverlayCropInput",
      "description": "Crop explicit overlays to a source rectangle. Coordinates are normalized with top-left origin. Optional time sets the crop at that local overlay time when a single image or scene already has keyframes. Omitting time explicitly replaces crop animation with a static crop while preserving placement keyframes.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.masks.setRegion",
      "symbol": "maskRegion",
      "input": "MaskRegionInput",
      "description": "Create or edit a rectangular solid-color mask on an image or generated overlay. Coordinates are source-image fractions from its top left; RGB values are 0\u20131. Use the attached source image to locate any requested area (text, face, logo, chart, or other content); OCR is optional evidence, not a requirement. Omit regionID to create a mask; use a saved ID to edit one. opacityKeys animate the cover: 1 conceals the area, 0 exposes it. The first opacity is held before the first key and the last after the last key: include the initial covered state explicitly before a fade. Each key accepts a shared timing anchor, including exact speech phrases. New masks default to a solid cover. Geometry-only edits omit opacityKeys and policy to preserve existing timing. policy/revealTime are compatibility shortcuts; use opacityKeys for new animations. Image conversion supports scene source durations of 0.5\u201330 seconds. Preserve unmentioned masks and source pixels. Unsupported mask styles, shapes, or moving-object tracking must be reported as unavailable.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.masks.remove",
      "symbol": "maskRemove",
      "input": "MaskRemoveInput",
      "description": "Remove one explicitly requested mask region and its opacity animation, leaving all other masks and original pixels intact.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.video.animateFraming",
      "symbol": "framingAnimation",
      "input": "FramingAnimationInput",
      "description": "Animate main-video scale, position, and rotation with ordered keyframes. Each key has a timeline timing anchor and a scale multiplier relative to the existing framing; optional x/y are frame-fraction offsets and rotation is a degree offset. easing controls the segment leading to the next key. pivot face keeps the detected face in place while scaling; frameCenter uses the current framing center. Existing keys outside the key interval and all other tracks are preserved. Keys may span video cuts. Use real times or local phrase/speechStart anchors; ambiguous or missing cues are rejected. Include a final multiplier 1 with zero offsets when returning to the existing framing. There is no implicit entry key: to begin smoothly from the existing framing, explicitly include an initial scaleMultiplier 1 with zero offsets at the beginning of the move, followed by the changed framing at its arrival time.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.audio.addAt",
      "symbol": "soundAt",
      "input": "SoundAtInput",
      "description": "Place an installed library sound at one or more timing anchors: explicit timeline times, playhead, speechStart, exact phrase/occurrence, or a saved animation event ID. Uses the same timing resolver as keyframes. Repeating the same effect at the same time is a no-op. Changes audio only.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.captions.setStyle",
      "symbol": "captionStyle",
      "input": "CaptionStyleInput",
      "description": "Set caption style fields on explicit caption IDs, or on the shared caption style when applyToAll is true. Send only the fields to change; unmentioned fields keep their values. Locked captions are skipped. Position, width and fontScale are fractions of the frame; strokeWidth is a fraction of the font size.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.text.setStyle",
      "symbol": "textLayerStyle",
      "input": "TextLayerStyleInput",
      "description": "Set style fields on explicit text layer IDs. Same fields and units as caption style; send only the fields to change.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.video.setFraming",
      "symbol": "videoFraming",
      "input": "VideoFramingInput",
      "description": "Set the static framing of explicit main-video clip IDs: scale multiplier, x/y offset as frame fractions, rotation in degrees. Send only the fields to change. Clips with framing keyframes are rejected; use editor.video.animateFraming for those. Locked clips are skipped.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.retouch.set",
      "symbol": "clipRetouch",
      "input": "ClipRetouchInput",
      "description": "Set face retouch strengths (0 to 1) on explicit clip IDs: clearBlemishes and whitenTeeth. Send only the fields to change. Locked clips are skipped.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.background.set",
      "symbol": "clipBackground",
      "input": "ClipBackgroundInput",
      "description": "Keep or remove the room behind the speaker on explicit clip IDs. When removed, the project backdrop colour shows behind the speaker. Locked clips are skipped.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.project.setBackdrop",
      "symbol": "projectBackdrop",
      "input": "ProjectBackdropInput",
      "description": "Set the project backdrop colour that fills the frame where there is no picture, including behind a speaker whose background is removed.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.audio.setVolume",
      "symbol": "audioVolume",
      "input": "AudioVolumeInput",
      "description": "Set playback volume (0 silent, 1 unity, up to 2) on explicit audio layer IDs and, when videoTrack is true, on the speaker's own video track. Raising the video track above 0 also unmutes it.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.timeline.split",
      "symbol": "timelineSplit",
      "input": "TimelineSplitInput",
      "description": "Split explicit timeline items (clips, captions, text layers, overlays, sounds) at one timeline anchor. Items the anchor does not fall inside are left alone. Locked clips and captions are skipped. The receipt names each new tail ID.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.timeline.delete",
      "symbol": "timelineDelete",
      "input": "TimelineDeleteInput",
      "description": "Remove explicit timeline items by ID: clips, captions, text layers, overlays, or sounds. Removing a clip closes the gap. Locked clips and captions are skipped.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.timeline.trim",
      "symbol": "timelineTrim",
      "input": "TimelineTrimInput",
      "description": "Move the leading or trailing edge of explicit timeline items to one timeline anchor. leading keeps everything after the anchor; trailing keeps everything before it. The anchor must fall inside each item. Locked items are skipped.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.clips.reorder",
      "symbol": "clipReorder",
      "input": "ClipReorderInput",
      "description": "Move explicit main-track clips as one block so it starts at insertionIndex among the remaining clips (0 is first). Cannot reorder across a locked clip.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.timeline.shift",
      "symbol": "timelineShift",
      "input": "TimelineShiftInput",
      "description": "Slide explicit captions, text layers, overlays, or sounds along the timeline by deltaSeconds (negative is earlier), clamped to the project. Clips are in a running order; use editor.clips.reorder for them.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.transcript.setWordsKept",
      "symbol": "transcriptWords",
      "input": "TranscriptWordsInput",
      "description": "Cut spoken words out of the edit (kept false) or put cut words back (kept true) by transcript word ID. Cutting removes that stretch of recording from the timeline; restoring brings it and its caption back.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.transcript.setPauseKept",
      "symbol": "transcriptPause",
      "input": "TranscriptPauseInput",
      "description": "Cut a pause (a stretch of a recording with no words, given in recording seconds for that media) out of the edit, or restore it.",
      "effect": "reversibleEdit",
      "requiresRebuild": true
    },
    {
      "id": "editor.captions.add",
      "symbol": "captionAdd",
      "input": "CaptionAddInput",
      "description": "Add a caption card. Either at a timeline anchor over spoken footage, or right after an existing caption (afterCaptionID). Optional text sets what the card says; otherwise it takes the spoken words there.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.captions.remove",
      "symbol": "captionRemove",
      "input": "CaptionRemoveInput",
      "description": "Remove explicit caption cards by ID. Locked captions are skipped. To hide all captions without deleting them use editor.captions.setVisible.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.captions.merge",
      "symbol": "captionMerge",
      "input": "CaptionMergeInput",
      "description": "Merge two or more caption cards into one card spanning them, keeping their words in order.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.captions.setText",
      "symbol": "captionText",
      "input": "CaptionTextInput",
      "description": "Replace the text of one caption card. The card stops following the transcript for that text.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.captions.retime",
      "symbol": "captionRetime",
      "input": "CaptionRetimeInput",
      "description": "Move a caption card to a new timeline start and end in seconds. A card can only sit over the footage it was spoken over.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.text.add",
      "symbol": "textLayerAdd",
      "input": "TextLayerAddInput",
      "description": "Add an on-screen text layer with the given text at a timeline anchor (default the playhead) for duration seconds (default 5). asHook places it at the very start with the hook look.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    },
    {
      "id": "editor.text.update",
      "symbol": "textLayerUpdate",
      "input": "TextLayerUpdateInput",
      "description": "Change a text layer's words, timeline start, or duration. Send only the fields to change. Remove a layer with editor.timeline.delete.",
      "effect": "reversibleEdit",
      "requiresRebuild": false
    }
  ],
  "$defs": {
    "ExtractAudioInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clipIDs", "overlayIDs"],
      "properties": {
        "clipIDs": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "overlayIDs": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "ClipSpeedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clipIDs", "rate"],
      "properties": {
        "clipIDs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "rate": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4
        }
      }
    },
    "TimelineLockInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clipIDs", "captionIDs", "locked"],
      "properties": {
        "clipIDs": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "captionIDs": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "locked": {
          "type": "boolean"
        }
      }
    },
    "CaptionVisibilityInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible"],
      "properties": {
        "visible": {
          "type": "boolean"
        }
      }
    },
    "AppActionStatus": {
      "type": "string",
      "enum": ["applied", "unchanged", "rejected", "failed", "canceled"]
    },
    "AppActionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "id",
        "projectID",
        "revision",
        "action",
        "arguments"
      ],
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "const": 1
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "projectID": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {}
        }
      }
    },
    "AppActionChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetID", "property", "before", "after"],
      "properties": {
        "targetID": {
          "type": "string",
          "format": "uuid"
        },
        "property": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        }
      }
    },
    "AppActionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "invocationID",
        "projectID",
        "revision",
        "action",
        "status",
        "message",
        "changes",
        "skippedIDs",
        "persisted"
      ],
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "const": 1
        },
        "invocationID": {
          "type": "string",
          "format": "uuid"
        },
        "projectID": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AppActionStatus"
        },
        "message": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AppActionChange"
          }
        },
        "skippedIDs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "persisted": {
          "type": "boolean"
        }
      }
    },
    "RevealPolicy": {
      "type": "string",
      "enum": ["alwaysVisible", "untilCue", "alwaysHidden"]
    },
    "RevealRegionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regionID", "policy"],
      "properties": {
        "regionID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "policy": {
          "$ref": "#/$defs/RevealPolicy"
        }
      }
    },
    "RevealPolicyInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlayID", "regions"],
      "properties": {
        "overlayID": {
          "type": "string",
          "format": "uuid"
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RevealRegionPolicy"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        }
      }
    },
    "RevealSoundsInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectID", "eventIDs"],
      "properties": {
        "effectID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "eventIDs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        }
      }
    },
    "ChirpyActionCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "arguments"],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {}
        }
      }
    },
    "ChirpyPlanReply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "actions"],
      "properties": {
        "message": {
          "type": "string",
          "maxLength": 2000
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChirpyActionCall"
          },
          "maxItems": 8
        }
      }
    },
    "TranscribeWorkflowInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction"],
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "CleanupWorkflowInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction"],
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "SilenceWorkflowInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction"],
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "clipIDs": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "OverlayWorkflowInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction"],
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "ActionRect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "minimum": 0.005,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "minimum": 0.005,
          "maximum": 1
        }
      }
    },
    "OverlayBoxInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -2,
          "maximum": 2
        },
        "y": {
          "type": "number",
          "minimum": -2,
          "maximum": 2
        },
        "width": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 4
        },
        "height": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 4
        }
      }
    },
    "OverlayKeyOperation": {
      "type": "string",
      "enum": ["set", "remove", "clear", "move"]
    },
    "OverlayZoomInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlayID", "target", "startTime", "endTime"],
      "properties": {
        "overlayID": {
          "type": "string",
          "format": "uuid"
        },
        "target": {
          "$ref": "#/$defs/ActionRect"
        },
        "startTime": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "endTime": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "returnStart": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "returnEnd": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        }
      }
    },
    "OverlayKeyframeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlayID", "time", "operation"],
      "properties": {
        "overlayID": {
          "type": "string",
          "format": "uuid"
        },
        "time": {
          "type": "number",
          "minimum": 0,
