    "TimelineAnchorKind": {
      "type": "string",
      "enum": ["time", "playhead", "speechStart", "phrase", "event"]
    },
    "TimelineAnchorInput": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/TimelineAnchorKind",
          "description": "speechStart is the beginning of speech, including entering/starting speaking; it requires no phrase. Use phrase for a specifically quoted part of speech, time for an explicit timestamp, playhead for here/now, event for an existing animation moment."
        },
        "time": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "phrase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "eventID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "offset": {
          "type": "number",
          "minimum": -86400,
          "maximum": 86400
        }
      },
      "required": ["kind"],
      "additionalProperties": false,
      "description": "A reusable timeline cue resolved locally from the current edit. speechStart means the first kept spoken word: no phrase or timestamp is required. phrase finds exact words, accounting for trims, cuts and playback speed; occurrence selects a repeated match. playhead means the current position. time uses explicit timeline seconds. event uses a saved animationEvents ID. offset adds seconds after resolution (negative is before)."
    },
