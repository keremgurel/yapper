{
  "id": "sweep-existing-overlays",
  "from": "overlay workflow structured input: a sound on every overlay already on the timeline is audio, never a placement",
  "tags": ["audio", "overlay-workflow"],
  "catalog": "current",
  "base": "imported-media",
  "append": {
    "media": [
      {
        "id": "89001F73-2A4F-4A18-AD01-53CE94B3D8A4",
        "name": "coffee-grinding.mov",
        "kind": "video",
        "onMainTrack": false,
        "usedAsOverlay": true
      },
      {
        "id": "CD66CB6B-167C-4507-A32F-95EB0B7E9121",
        "name": "coffee-brewing.mov",
        "kind": "video",
        "onMainTrack": false,
        "usedAsOverlay": true
      },
      {
        "id": "3B65E744-6778-4B61-A44E-E4CD3CA4AFD9",
        "name": "sales-chart.png",
        "kind": "image",
        "onMainTrack": false,
        "usedAsOverlay": true
      }
    ]
  },
  "context": {
    "timelineItems": [
      {
        "id": "5B3AA239-197A-4576-AEC7-73A217BC60C8",
        "kind": "overlay",
        "start": 4.2,
        "end": 7.2,
        "media": "coffee-grinding.mov"
      },
      {
        "id": "870368D0-094A-46BC-ABAC-EA814CEE6F7D",
        "kind": "overlay",
        "start": 11.8,
        "end": 14.8,
        "media": "coffee-brewing.mov"
      },
      {
        "id": "0465356D-B145-4078-ABF9-059AF49015E0",
        "kind": "overlay",
        "start": 19.5,
        "end": 22.5,
        "media": "sales-chart.png"
      }
    ],
    "soundLibrary": [
      {
        "id": "pop",
        "name": "Pop"
      },
      {
        "id": "woosh",
        "name": "Woosh"
      },
      {
        "id": "camera-shutter",
        "name": "Camera shutter"
      },
      {
        "id": "cha-ching",
        "name": "Cha-ching"
      }
    ],
    "sounds": []
  },
  "messages": [
    {
      "role": "user",
      "content": "add a pop sound on every overlay we have"
    }
  ],
  "expect": {
    "actions": ["editor.audio.addAt"],
    "args": [
      {
        "action": "editor.audio.addAt",
        "pointer": "/effectID",
        "equals": "pop"
      },
      {
        "action": "editor.audio.addAt",
        "pointer": "/at",
        "length": 3
      },
      {
        "action": "editor.audio.addAt",
        "pointer": "/at",
        "every": {
          "allOf": [
            {
              "pointer": "/kind",
              "equals": "time"
            },
            {
              "pointer": "/offset",
              "absent": true
            }
          ]
        }
      },
      {
        "action": "editor.audio.addAt",
        "pointer": "/at",
        "some": {
          "pointer": "/time",
          "equals": 4.2
        }
      },
      {
        "action": "editor.audio.addAt",
        "pointer": "/at",
        "some": {
          "pointer": "/time",
          "equals": 11.8
        }
      },
      {
        "action": "editor.audio.addAt",
        "pointer": "/at",
        "some": {
          "pointer": "/time",
          "equals": 19.5
        }
      }
    ]
  }
}
