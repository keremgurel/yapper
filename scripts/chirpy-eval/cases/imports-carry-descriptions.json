{
  "id": "imports-carry-descriptions",
  "from": "planner.integration.test.ts: carries the user's filename descriptions into the placement workflow after clarification",
  "tags": ["imports", "multi-turn"],
  "catalog": "current",
  "base": "imported-media",
  "append": {
    "media": [
      {
        "id": "F058E673-7D8A-4212-ADD7-755A2E93D327",
        "name": "IMG_1234.mov",
        "kind": "video",
        "onMainTrack": false,
        "usedAsOverlay": false
      },
      {
        "id": "87DD4FA6-9CF3-4E30-A063-BC24977D8BA3",
        "name": "DSC_0042.png",
        "kind": "image",
        "onMainTrack": false,
        "usedAsOverlay": false
      }
    ]
  },
  "messages": [
    {
      "role": "user",
      "content": "i uploaded a ton of meda to use as overlays. overlay parts of them wherever they make sense"
    },
    {
      "role": "assistant",
      "content": "Please give IMG_1234.mov and DSC_0042.png descriptive names, or tell me what each shows so I can match them to the transcript."
    },
    {
      "role": "user",
      "content": "IMG_1234.mov shows coffee brewing and DSC_0042.png is our sales chart. Go ahead."
    }
  ],
  "expect": {
    "actions": ["editor.designOverlays"],
    "args": [
      {
        "pointer": "/mode",
        "equals": "placeImported"
      },
      {
        "pointer": "/instruction",
        "matches": "IMG_1234.mov"
      },
      {
        "pointer": "/instruction",
        "matches": "coffee brewing",
        "flags": "i"
      },
      {
        "pointer": "/instruction",
        "matches": "DSC_0042.png"
      },
      {
        "pointer": "/instruction",
        "matches": "sales chart",
        "flags": "i"
      }
    ]
  }
}
