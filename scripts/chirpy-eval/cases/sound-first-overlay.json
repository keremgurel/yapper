        "end": 14.8,
        "media": "Screenshot 2.png"
      },
      {
        "id": "0465356D-B145-4078-ABF9-059AF49015E0",
        "kind": "overlay",
        "start": 19.5,
        "end": 22.5,
        "media": "Screenshot 3.png"
      }
    ],
    "soundLibrary": [
      {
        "id": "mouse-click",
        "name": "Mouse click"
      },
      {
        "id": "camera-shutter",
        "name": "Camera shutter"
      },
      {
