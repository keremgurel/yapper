{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "remote": {
    "urls": ["https://ypr.app/*"]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "allow-probe-media",
    "allow-companion-proxy",
    "allow-start-proxy",
    "allow-proxy-status",
    "allow-start-edit-preview",
    "allow-edit-preview-status",
    "allow-start-thumbnails",
    "allow-list-thumbnails",
    "allow-start-waveform",
    "allow-list-waveform",
    "allow-extract-audio",
    "allow-extract-audio-bytes",
    "allow-prepare-pcm",
    "allow-extract-pcm-chunk",
    "allow-prepare-export-pcm",
    "allow-extract-export-pcm-chunk",
    "allow-open-oauth-flow",
    "allow-open-microphone-settings"
  ]
}
