    "@remotion/zod-types": "4.0.545",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.545",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "typescript": "^5"
  }
