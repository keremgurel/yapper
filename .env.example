# Variables added with the Train and Studio split. Names only: real values live
# in .env.local (gitignored) and in the Vercel project. This is not the full
# list of what the app reads.

# Train Plus prices in Stripe (product "Yapper Train Plus"). Until both are
# set, Train Plus checkout answers that the plan is not available yet.
STRIPE_PRICE_TRAIN_PLUS_MONTHLY=
STRIPE_PRICE_TRAIN_PLUS_YEARLY=

# Azure Speech, for pronunciation and intonation scoring on Train feedback.
# Resource "yapper-speech" in resource group "yapper-dev-rg". Without these a
# feedback report has no pronunciation section.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Read-only analytics queries (scripts/posthog-query.mjs). Local only.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Studio private beta. ADMIN_USER_IDS is a comma-separated list of Clerk user
# ids who may open /studio/admin/beta. The from address must be on a domain
# verified in Resend; until it is set, approvals show the access code in the
# admin panel instead of emailing it.
ADMIN_USER_IDS=
STUDIO_BETA_FROM_EMAIL=
STUDIO_BETA_REPLY_TO=

# Serve Studio from its own host (for example studio.ypr.app). Leave empty to
# keep Studio at ypr.app/studio. See src/lib/routing/studio-host.ts.
STUDIO_HOST=
